[Unit]
Description=Check GitHub for radio updates and apply them
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /home/pi/tivo/auto-update.sh
User=pi
Group=pi

# Allow network and git access
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
