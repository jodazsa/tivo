# Adobe Lightroom API credentials
# Copy this file to .env and fill in your values.
#
# 1. Go to https://developer.adobe.com/console
# 2. Create a new project and add the "Lightroom" API
# 3. Choose "OAuth Server-to-Server" credential type
# 4. Copy the Client ID and Client Secret below
#
# Alternatively, if you have a pre-obtained user access token
# (e.g. from Adobe's OAuth flow), set ADOBE_ACCESS_TOKEN directly
# and leave CLIENT_ID / CLIENT_SECRET empty.

ADOBE_CLIENT_ID=your_client_id_here
ADOBE_CLIENT_SECRET=your_client_secret_here

# Optional: pre-obtained OAuth access token (skips client credentials flow)
# ADOBE_ACCESS_TOKEN=

# How often to check for new photos (seconds). Default: 15
# POLL_INTERVAL_SECONDS=15

# On startup, look this many minutes into the past for any photos
# already being imported. Default: 5
# LOOKBACK_MINUTES=5
